{
  "name": "pixelvision-monorepo",
  "private": true,
  "description": "Typed, tested computer vision for JavaScript: a modern replacement for jsfeat.",
  "license": "MIT",
  "author": "Sil van Diepen",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:models && pnpm test && pnpm build",
    "check:models": "node scripts/check-models.mjs",
    "check:packages": "node scripts/check-packages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "turbo": "2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "publint": "0.3.12",
    "@arethetypeswrong/cli": "0.18.5"
  }
}
