{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    // `.cts` files are written with `import` and compiled to `require()`, which
    // verbatimModuleSyntax doesn't allow.
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src", "test", "*.config.ts"]
}
