{
  "name": "@pixelvision/verify",
  "version": "0.5.0",
  "description": "Server-side check for pixelvision face challenges: issues a signed, expiring, one-time challenge and verifies the uploaded frames by running the detection again.",
  "license": "MIT",
  "author": "Sil van Diepen",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jpeg-js": "0.4.4"
  },
  "peerDependencies": {
    "pixelvision": "workspace:^"
  },
  "devDependencies": {
    "pixelvision": "workspace:*",
    "tsup": "^9.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "liveness",
    "face-challenge",
    "verification",
    "pixelvision"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvandiepen/pixelvision.git",
    "directory": "packages/verify"
  },
  "homepage": "https://github.com/silvandiepen/pixelvision/tree/main/packages/verify#readme",
  "bugs": {
    "url": "https://github.com/silvandiepen/pixelvision/issues"
  }
}
