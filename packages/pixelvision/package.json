{
  "name": "pixelvision",
  "version": "0.5.0",
  "description": "Typed, tested computer vision for JavaScript: image processing, features, tracking and detection.",
  "license": "MIT",
  "author": "Sil van Diepen",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cascades/*": {
      "import": {
        "types": "./dist/cascades/*.d.ts",
        "default": "./dist/cascades/*.js"
      },
      "require": {
        "types": "./dist/cascades/*.d.cts",
        "default": "./dist/cascades/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/cascades/*.map",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^9.0.0"
  },
  "keywords": [
    "computer-vision",
    "image-processing",
    "canny",
    "edge-detection",
    "feature-detection",
    "optical-flow",
    "face-detection",
    "jsfeat",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvandiepen/pixelvision.git",
    "directory": "packages/pixelvision"
  },
  "homepage": "https://pixelvision.hakobs.com",
  "bugs": {
    "url": "https://github.com/silvandiepen/pixelvision/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "typesVersions": {
    "*": {
      "cascades/*": [
        "./dist/cascades/*.d.ts"
      ]
    }
  }
}
