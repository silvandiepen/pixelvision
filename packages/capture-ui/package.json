{
  "name": "@pixelvision/capture-ui",
  "version": "0.1.0",
  "description": "Customisable camera capture UI for pixelvision as Web Components: a selfie flow with a head-turn challenge and a document scanner that finds and straightens documents. Capture only: not liveness detection or document verification.",
  "license": "MIT",
  "author": "Sil van Diepen",
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./src/index.ts"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./haar-worker": {
      "import": "./dist/haar-worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "test": "vitest run --coverage",
    "test:e2e": "pnpm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "demo": "node demo/serve.mjs"
  },
  "peerDependencies": {
    "@pixelvision/face-neural": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@pixelvision/face-neural": {
      "optional": true
    }
  },
  "dependencies": {
    "pixelvision": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "happy-dom": "20.14.5",
    "tsup": "^9.0.0"
  },
  "keywords": [
    "web-components",
    "camera",
    "head-pose",
    "face-detection",
    "document-scanner",
    "kyc"
  ],
  "engines": {
    "node": ">=22"
  }
}
